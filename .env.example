# Copie este arquivo para .env e preencha os valores
DISCORD_TOKEN=seu_token_do_bot
# ID do servidor Discord (Modo desenvolvedor → copiar ID do servidor)
DISCORD_GUILD_ID=
# Cargo Cinéfilo — sorteio e criar evento no site (padrão: mesmo ID do aviso /evento)
# EVENTO_CINEFILO_ROLE_ID=1508308918353526814
OMDB_API_KEY=sua_chave_omdb
# Capa horizontal dos eventos (/evento) — https://www.themoviedb.org/settings/api
TMDB_API_KEY=sua_chave_tmdb
DISCORD_CLIENT_ID=seu_client_id
DISCORD_CLIENT_SECRET=seu_client_secret
DISCORD_REDIRECT_URI=http://localhost:5000/auth/callback
# Login do site usa scope guilds.members.read (checar cargo Cinéfilo)
SECRET_KEY=uma_string_aleatoria_qualquer
WEB_URL=http://localhost:5000
# URL do deployment Convex (rode `npx convex dev` e copie a URL .convex.cloud)
CONVEX_URL=https://seu-deploy.convex.cloud
# ID do canal de voz fixo para /evento (Modo desenvolvedor → copiar ID do canal)
EVENTO_VOICE_CHANNEL_ID=
# Canal de texto para aviso com @Cinéfilo (recomendado — ID do canal de filmes/avisos)
# EVENTO_ANNOUNCE_CHANNEL_ID=
# Opcional: busca por nome se o ID não estiver definido
# EVENTO_VOICE_CHANNEL_NAME=Cineminha
# Opcional no Railway: normalmente o próprio Railway injeta PORT automaticamente.
# PORT=5000
